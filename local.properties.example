# Скопируйте этот файл в local.properties (рядом с ним) и впишите свои значения.
# Android Studio сама добавит строку sdk.dir при первом открытии проекта.

# Путь к Android SDK (нужен только при сборке из командной строки)
sdk.dir=/home/ИМЯ_ПОЛЬЗОВАТЕЛЯ/Android/Sdk

# Ключ API DeepSeek (https://platform.deepseek.com/api_keys).
# Если указать его здесь, он сразу будет вшит в приложение и вводить его на часах не придётся.
deepseek.apiKey=sk-ВАШ_КЛЮЧ
